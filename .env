# Fill these in, then save. Never share this file.

# Supabase > Project Settings > Database > Connection string.
# 1) DATABASE_URL = "Transaction pooler" string (port 6543), add ?pgbouncer=true
# 2) DIRECT_URL   = "Session pooler" string (port 5432) - used for migrations
# If your password contains special characters (@ # / : ?), URL-encode them
# (@ becomes %40). Easiest: reset the DB password to letters and numbers only.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="PASTE_A_NEW_RANDOM_STRING_HERE"

PORT=4000
OCR_PORT=4001
